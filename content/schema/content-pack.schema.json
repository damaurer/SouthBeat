            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "wall": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "ceiling": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "floor": {
            "type": "object",

            "required": [
              "color",
              "kind"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "kind": {
                "enum": [
                  "tiles",
                  "carpet",
                  "wood",
                  "concrete",
                  "raised"
                ]
              }
            }
          },
          "props": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "x",
                    "y",
                    "w",
                    "h",
                    "sky"
                  ],
                  "properties": {
                    "type": {
                      "const": "window"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 239
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 120
                    },
                    "h": {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 70
                    },
                    "sky": {
                      "enum": [
                        "day",
                        "sunset",
                        "night"
                      ]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://southbeat.local/content-pack.schema.json",
  "title": "SouthBeat-Inhaltspaket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "const": 1
    },
    "moves": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "slot",
          "damage",
          "startupFrames"
        ],
        "description": "Ausgewogen: damage × hits − startupFrames/2 muss im erlaubten Bereich des Slots liegen (siehe AGENTS.md).",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "slot": {
            "enum": [
              "light",
              "heavy",
              "kick",
              "special",
              "ultimate"
            ]
          },
          "damage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36
          },
          "startupFrames": {
            "type": "integer",
            "minimum": 3,
            "maximum": 30
          },
          "reach": {
            "type": "integer",
            "minimum": 16,
            "maximum": 200
          },
          "knockback": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "hitstun": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "hits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "projectileSpeed": {
            "type": "number",
            "minimum": 1,
            "maximum": 8
          },
          "arc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "dashSpeed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "exclusive": {
            "type": "boolean",
            "description": "Signatur-Move: nur für Kämpfer aus diesem Paket."
          },
          "look": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "colors": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9 !?.\\-:/]{1,10}$"
              }
            }
          }
        }
      }
    },
    "arenas": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "wall",
          "floor",
          "props"
        ],
        "description": "Bild 240×135 Pixel, Wand bis y=100, darunter Boden. Props werden der Reihe nach gemalt.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },

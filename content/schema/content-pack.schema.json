                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 239
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 24,
                      "maximum": 90
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
